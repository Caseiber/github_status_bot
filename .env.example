# Copy this file to .env and fill in the values. Never commit a populated .env.

# Bot User OAuth Token — OAuth & Permissions → Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token for socket mode — Basic Information → App-Level Tokens (xapp-...)
# Must have the connections:write scope
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Signing Secret — Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# --- Phase 2: Proactive alerting (required for poller.py) ---

# Slack channel ID where outage/recovery alerts are posted
# Find it by right-clicking the channel in Slack → Copy link → the last path segment is the ID (C...)
ALERT_CHANNEL_ID=C0123456789

# Path for the poller state file (optional — defaults to gh_status_state.json in the working directory)
# Use an absolute path when running via cron to avoid ambiguity
# STATE_FILE_PATH=/absolute/path/to/gh_status_state.json
